rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Comprovantes de pagamento (prints/PDFs de Pix) anexados na inscrição pública.
    // Upload: qualquer pessoa pode enviar (a inscrição pública não exige login) — mas só imagem/PDF,
    // até 8 MB, pra evitar abuso óbvio.
    // Leitura: só o admin logado consegue pedir o link de download — assim os comprovantes (que têm
    // dado financeiro) não ficam visíveis pra qualquer visitante do torneio.
    match /comprovantes/{tournamentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
